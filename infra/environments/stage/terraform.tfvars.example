aws_region = "ap-south-1"
project_name = "devsecops-demo"

# From `terraform output github_oidc_provider_arn` in infra/bootstrap
github_oidc_provider_arn = "arn:aws:iam::ACCOUNT_ID:oidc-provider/token.actions.githubusercontent.com"

github_org  = "your-github-username"
github_repo = "devsecops-pipeline-demo"
